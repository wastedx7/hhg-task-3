# --- Chain selection -------------------------------------------------------
# local  = in-process Ethereum EVM (eth-tester). No setup. Chain lives for the
#          duration of the run; on-chain verification happens in-process right
#          after recording.
# rpc    = connect to any JSON-RPC chain: a local ganache/hardhat node or a
#          public testnet (durable records you can verify later).
FACEFINDER_CHAIN=local

# --- RPC backend settings (needed only when FACEFINDER_CHAIN=rpc) ----------
# Example: a local ganache node
#   npx ganache --server.host 127.0.0.1 --server.port 8545 \
#               --chain.chainId 1337 --wallet.deterministic --logging.quiet
#RPC_URL=http://127.0.0.1:8545
#CHAIN_ID=1337
#PRIVATE_KEY=0x4f3edf983ac636a65a842ce7c78d9aa706d3b113bce9c46f30d7d25115b335fb

# Or a public testnet, e.g. Base Sepolia:
#RPC_URL=https://sepolia.base.org
#CHAIN_ID=84532
#PRIVATE_KEY=<your-funded-key>

# --- Face model ------------------------------------------------------------
#FACEFINDER_FACE_MODEL=buffalo_l

# --- Search engine ---------------------------------------------------------
# Only the Yandex engine is currently implemented (by URL).
#FACEFINDER_ENGINE=yandex